---
import { site } from '../data/site';

const socialLinks = [
  site.github ? { label: 'GitHub', href: site.github } : null,
  site.linkedin ? { label: 'LinkedIn', href: site.linkedin } : null,
].filter(Boolean) as { label: string; href: string }[];

const year = new Date().getFullYear();
---
<footer id="contact" class="bg-surface-container-lowest text-on-surface w-full mt-xl scroll-mt-[80px]">
  <div class="max-w-content mx-auto px-margin-mobile md:px-margin-desktop py-lg flex flex-col gap-lg">
    <div class="flex flex-col md:flex-row justify-between items-start gap-lg border-b border-outline-variant pb-lg">
      <div>
        <h2 class="font-display text-[32px] font-extrabold text-on-surface mb-md">Let's connect.</h2>
        <p class="font-body text-body-lg text-on-surface-variant max-w-sm">
          Always open to discussing economic research, potential collaborations, or the latest data trends.
        </p>
        <p class="font-body text-body-lg text-on-surface-variant mt-md">
          Email: <span class="text-primary font-bold">{site.email}</span>
        </p>
      </div>
      <div class="flex flex-col gap-sm">
        {socialLinks.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="text-[24px] md:text-[32px] font-bold text-on-surface hover:text-primary transition-colors flex items-center gap-md"
          >
            {l.label}
            <span class="material-symbols-outlined">north_east</span>
          </a>
        ))}
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-between items-center gap-md">
      <div class="font-display text-headline-md font-bold text-on-surface">{site.name}</div>
      <p class="font-label text-label-sm text-on-surface-variant/80">
        © {year} {site.name}.
      </p>
    </div>
  </div>
</footer>
