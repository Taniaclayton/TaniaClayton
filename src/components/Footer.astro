---
import { site } from '../data/site';

const socialLinks = [
  site.github ? { label: 'GitHub', href: site.github } : null,
  site.linkedin ? { label: 'LinkedIn', href: site.linkedin } : null,
].filter(Boolean) as { label: string; href: string }[];

const year = new Date().getFullYear();
---
<footer id="contact" class="bg-surface-container-lowest text-on-surface w-full mt-lg scroll-mt-[80px]">
  <div class="max-w-content mx-auto px-margin-mobile md:px-margin-desktop py-md flex flex-col gap-md">
    <div class="flex flex-col md:flex-row justify-between items-start gap-md border-b border-outline-variant pb-md">
      <div>
        <h2 class="font-display text-[32px] font-extrabold text-on-surface mb-md">Feel free to reach out!</h2>
        <p class="font-body text-body-lg text-on-surface-variant max-w-md">
          I enjoy exchanging ideas and experiences. If you'd like to chat, collaborate or just need some guidance, don't hesitate to connect through my social links.
        </p>
        <p class="font-body text-body-lg text-on-surface-variant mt-md">
          Email: <span class="text-primary font-bold">{site.email}</span>
        </p>
      </div>
      <div class="flex flex-col gap-sm">
        {socialLinks.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="text-[24px] md:text-[32px] font-bold text-on-surface hover:text-primary transition-colors flex items-center gap-md"
          >
            {l.label}
            <span class="material-symbols-outlined">north_east</span>
          </a>
        ))}
      </div>
    </div>
    <div class="flex justify-center">
      <p class="font-label text-label-sm text-on-surface-variant/40">
        © {year} {site.name}.
      </p>
    </div>
  </div>
</footer>
