---
// Two stats are real (NUS, location); two are PLACEHOLDER — update value/label.
const stats = [
  { label: 'WHAT I DO', value: 'MECON @ NUS', accent: 'text-primary' },
  { label: 'WHAT I LIKE', value: 'Interests', accent: 'text-secondary' }, // PLACEHOLDER
  { label: "WHERE I'M AT", value: 'Chennai / Singapore', accent: 'text-on-surface-variant' },
];
---
<div class="border-t border-outline-variant pt-lg">
  <div class="grid grid-cols-2 md:grid-cols-3 gap-gutter">
    {stats.map((s) => (
      <div>
        <span class={`font-label text-label-sm block mb-xs ${s.accent}`}>{s.label}</span>
        <span class="font-display text-headline-md font-bold">{s.value}</span>
      </div>
    ))}
  </div>
</div>
