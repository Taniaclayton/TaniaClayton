---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  showHeader?: boolean;
  showViewAll?: boolean;
}
const { posts, showHeader = true, showViewAll = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase();
---
<section id="blog" class="py-xl max-w-content mx-auto px-margin-mobile md:px-margin-desktop scroll-mt-[80px]">
  {showHeader && (
    <div class="flex flex-col md:flex-row justify-between items-end gap-md mb-lg border-b border-outline-variant pb-md">
      <div>
        <span class="font-label text-label-sm text-primary mb-sm inline-block tracking-widest uppercase">The Ledger</span>
        <h2 class="font-display text-display-lg-mobile md:text-display-lg font-extrabold">Economic Musings</h2>
      </div>
      <p class="font-body text-body-lg text-on-surface-variant max-w-sm mb-sm italic">
        Thoughts on behavioural economics, market anomalies, and the future of finance.
      </p>
    </div>
  )}

  <div class="space-y-lg">
    {posts.map((post) => (
      <a href={`${base}/blog/${post.slug}`} class="group block">
        <div class="flex flex-col md:flex-row gap-md md:items-center">
          <span class="font-label text-label-sm text-on-surface-variant md:w-32">{fmt(post.data.pubDate)}</span>
          <div class="flex-1">
            <h3 class="font-display text-headline-md font-bold group-hover:text-primary transition-colors mb-xs">{post.data.title}</h3>
            {post.data.excerpt && (
              <p class="font-body text-body-md text-on-surface-variant font-light line-clamp-2">{post.data.excerpt}</p>
            )}
          </div>
          <span class="hidden md:block material-symbols-outlined text-outline-variant group-hover:text-primary group-hover:translate-x-2 transition-all">arrow_forward</span>
        </div>
      </a>
    ))}
  </div>

  {showViewAll && (
    <div class="mt-lg">
      <a href={`${base}/blog`} class="font-label text-label-sm border-b-2 border-on-surface py-1 hover:border-primary hover:text-primary transition-all">VIEW ALL POSTS</a>
    </div>
  )}
</section>
