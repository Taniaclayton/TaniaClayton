---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Portfolio | Tania Clayton" onHome={false}>
  <main class="pt-[120px] min-h-screen pb-xl">
    <div class="max-w-content mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="font-label text-label-sm text-primary mb-sm inline-block">Portfolio</span>
      <h1 class="font-display text-display-lg-mobile md:text-display-lg font-extrabold mb-lg">All Work</h1>

      <div>
        {projects.map((p) => (
          <a
            href={p.href ?? '#'}
            class="group flex items-center gap-md py-lg border-b border-outline-variant hover:border-primary transition-all"
          >
            <div class="flex-1">
              <span class="font-label text-label-sm text-primary mb-xs block">{p.category}</span>
              <h2 class="font-display text-headline-md font-bold group-hover:text-primary transition-colors mb-xs">{p.title}</h2>
              {p.description && (
                <p class="font-body text-body-md text-on-surface-variant">{p.description}</p>
              )}
            </div>
            <span class="material-symbols-outlined text-outline-variant group-hover:text-primary group-hover:translate-x-2 transition-all flex-shrink-0">arrow_forward</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
