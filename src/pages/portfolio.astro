---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Portfolio | Tania Clayton" onHome={false}>
  <main class="pt-[72px] min-h-screen">
    <div class="bg-inverse-surface text-inverse-on-surface py-xl min-h-screen">
      <div class="max-w-content mx-auto px-margin-mobile md:px-margin-desktop">

        <div class="mb-lg flex items-center gap-md">
          <a href={`${base}/`} class="text-on-secondary-fixed-variant hover:text-inverse-on-surface transition-colors flex items-center gap-sm font-body text-body-md">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            Back
          </a>
        </div>

        <div class="mb-lg">
          <span class="font-label text-label-sm text-on-secondary-fixed-variant mb-sm inline-block tracking-widest uppercase">All Work</span>
          <h1 class="font-display text-display-lg-mobile md:text-display-lg font-extrabold text-inverse-on-surface">Full Portfolio</h1>
        </div>

        <div class="bento-grid">
          {projects.map((p) => (
            <a
              href={p.href ?? '#'}
              class:list={[
                'group relative rounded-xl overflow-hidden cursor-pointer ring-0 ring-secondary-container hover:ring-2 transition-all bg-surface-container-high text-on-surface',
                p.size === 'large' ? 'bento-large p-sm' : 'p-md flex flex-col justify-between',
              ]}
            >
              {p.image && (
                <img
                  src={`${base}/images/${p.image}`}
                  alt={p.title}
                  class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:scale-110 transition-transform duration-500"
                />
              )}

              {p.size === 'large' ? (
                <div class="relative h-full flex flex-col justify-end p-md">
                  {!p.image && p.icon && (
                    <span class="material-symbols-outlined absolute top-md left-md text-primary text-[40px]">{p.icon}</span>
                  )}
                  <span class={`font-label text-label-sm ${p.chipClass} px-sm py-1 w-fit mb-sm rounded-full`}>{p.category}</span>
                  <h3 class="font-display text-headline-md font-bold mb-xs">{p.title}</h3>
                  {p.description && <p class="font-body text-body-md text-on-surface-variant opacity-80 max-w-md">{p.description}</p>}
                </div>
              ) : (
                <div class="relative h-full flex flex-col justify-between">
                  <div class="w-12 h-12 bg-surface-container-lowest grid place-items-center rounded-lg">
                    <span class="material-symbols-outlined text-primary">{p.icon}</span>
                  </div>
                  <div>
                    <span class="font-label text-label-sm uppercase tracking-tighter mb-sm block opacity-70">{p.category}</span>
                    <h3 class="font-display text-headline-md font-bold">{p.title}</h3>
                  </div>
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 300px;
    }
    .bento-large {
      grid-column: span 2;
    }
  }
</style>
