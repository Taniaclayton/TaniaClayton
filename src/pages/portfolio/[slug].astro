---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('portfolio', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

type Props = { item: CollectionEntry<'portfolio'> };
const { item } = Astro.props;
const { Content } = await item.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`${item.data.title} | Tania Clayton`} description={item.data.description} onHome={false}>
  <main class="pt-[120px] pb-xl min-h-screen">
    <article class="max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop">
      <a href={`${base}/portfolio`} class="font-label text-label-sm text-on-surface-variant hover:text-primary inline-flex items-center gap-xs mb-md">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span> All work
      </a>

      {item.data.image && (
        <div class="rounded-xl overflow-hidden mb-lg aspect-[16/9]">
          <img src={`${base}/images/${item.data.image}`} alt={item.data.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="mb-md flex flex-wrap gap-sm">
        {item.data.tags.map((t) => (
          <span class="font-label text-label-sm bg-primary text-on-primary px-sm py-1 rounded-full uppercase">{t}</span>
        ))}
      </div>

      <span class="font-label text-label-sm text-primary uppercase tracking-widest block mb-sm">{item.data.category}</span>
      <h1 class="font-display text-display-lg-mobile md:text-display-lg font-extrabold mb-lg leading-tight">{item.data.title}</h1>

      <div class="post-body font-body text-body-lg text-on-surface-variant max-w-none">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .post-body h2 { font-family: 'Hanken Grotesk', sans-serif; font-weight: 800; font-size: 24px; margin: 2rem 0 0.75rem; color: rgb(var(--c-on-surface)); }
  .post-body h3 { font-family: 'Hanken Grotesk', sans-serif; font-weight: 700; font-size: 20px; margin: 1.5rem 0 0.5rem; color: rgb(var(--c-on-surface)); }
  .post-body p { margin: 0 0 1rem; line-height: 1.7; }
  .post-body a { color: rgb(var(--c-primary)); text-decoration: underline; }
  .post-body ul, .post-body ol { margin: 0 0 1rem 1.25rem; }
  .post-body ul { list-style: disc; }
  .post-body ol { list-style: decimal; }
  .post-body li { margin: 0.25rem 0; }
  .post-body strong, .post-body b { color: rgb(var(--c-on-surface)); }
  .post-body blockquote { border-left: 3px solid rgb(var(--c-primary)); padding-left: 1rem; color: rgb(var(--c-on-surface-variant)); margin: 1rem 0; }
  .post-body hr { border-color: rgb(var(--c-outline-variant)); margin: 2rem 0; }
  .post-body code { font-family: ui-monospace, 'Cascadia Code', Menlo, monospace; font-size: 0.9em; background: rgb(var(--c-surface-container)); padding: 0.1em 0.35em; border-radius: 4px; }
</style>
