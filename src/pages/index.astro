---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
---
<BaseLayout>
  <main class="pt-[72px]">
    <Hero />
    <section id="about" class="py-xl max-w-content mx-auto px-margin-mobile md:px-margin-desktop scroll-mt-[80px]">
      <StatsBar />
      <div class="mt-xl">
        <span class="font-label text-label-sm text-primary mb-sm inline-block uppercase tracking-widest">About me</span>
        <h2 class="font-display text-display-lg-mobile md:text-display-lg font-extrabold mb-lg">Who I Am</h2>
        <div class="max-w-2xl">
          <p class="font-body text-body-lg text-on-surface-variant leading-relaxed">
            <!-- Add your about text here -->
            Your about text goes here. Tell readers about yourself, your background, your interests, and what drives your work.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
