---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<BaseLayout title={`${post.data.title} | Tania Clayton`} description={post.data.excerpt} onHome={false}>
  <main class="pt-[120px] pb-xl min-h-screen">
    <article class="max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop">
      <a href={`${base}/blog`} class="font-label text-label-sm text-on-surface-variant hover:text-primary inline-flex items-center gap-xs mb-md">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span> All posts
      </a>
      <div class="mb-md flex flex-wrap gap-sm">
        {post.data.tags.map((t) => (
          <span class="font-label text-label-sm bg-primary text-on-primary px-sm py-1 rounded-full uppercase">{t}</span>
        ))}
      </div>
      <h1 class="font-display text-display-lg-mobile md:text-display-lg font-extrabold mb-sm leading-tight">{post.data.title}</h1>
      <p class="font-label text-label-sm text-on-surface-variant mb-lg">{fmt(post.data.pubDate)}</p>
      <div class="post-body font-body text-body-lg text-on-surface-variant max-w-none">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .post-body h2 { font-family: 'Hanken Grotesk', sans-serif; font-weight: 800; font-size: 24px; margin: 2rem 0 0.75rem; color: rgb(var(--c-on-surface)); }
  .post-body h3 { font-family: 'Hanken Grotesk', sans-serif; font-weight: 700; font-size: 20px; margin: 1.5rem 0 0.5rem; color: rgb(var(--c-on-surface)); }
  .post-body p { margin: 0 0 1rem; line-height: 1.7; }
  .post-body a { color: rgb(var(--c-primary)); text-decoration: underline; }
  .post-body ul, .post-body ol { margin: 0 0 1rem 1.25rem; }
  .post-body ul { list-style: disc; }
  .post-body ol { list-style: decimal; }
  .post-body li { margin: 0.25rem 0; }
  .post-body strong, .post-body b { color: rgb(var(--c-on-surface)); }
  .post-body hr { border-color: rgb(var(--c-outline-variant)); margin: 2rem 0; }
  .post-body code { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; background: rgb(var(--c-surface-container)); padding: 0.1em 0.35em; border-radius: 4px; }
</style>
