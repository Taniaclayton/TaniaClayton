---
import BaseLayout from '../layouts/BaseLayout.astro';

// PLACEHOLDER reading list (migrated from the old site) — swap in your real books.
const books = [
  'Robert Burton: *The Anatomy of Melancholy*',
  'Robert Musil: *The Man Without Qualities*',
  'Kazuo Ishiguro: *The Unconsoled*',
  'Malcolm Lowry: *Under the Volcano*',
  'Virginia Woolf: *The Waves*',
  'James Joyce: *Finnegans Wake*',
  'Thomas Wolfe: *Look Homeward, Angel*',
  'William Thackeray: *Pendennis*',
  'Karl Marx: *Capital*',
  'James Woodforde: *The Diary of A Country Parson*',
];
const render = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<BaseLayout title="Reading List | Tania Clayton" onHome={false}>
  <main class="pt-[120px] pb-xl min-h-screen">
    <div class="max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="font-label text-label-sm text-tertiary mb-sm inline-block tracking-widest uppercase">A list of books I read</span>
      <h1 class="font-display text-display-lg-mobile md:text-display-lg font-extrabold mb-md">Reading List</h1>
      <p class="font-body text-body-lg text-on-surface-variant mb-lg">I love books! Here are some I'm reading now:</p>
      <ol class="space-y-sm">
        {books.map((b, i) => (
          <li class="flex gap-md font-body text-body-lg">
            <span class="font-label text-label-sm text-primary pt-1">{String(i + 1).padStart(2, '0')}</span>
            <span set:html={render(b)} />
          </li>
        ))}
      </ol>
    </div>
  </main>
</BaseLayout>
